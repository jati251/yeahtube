# YeahTube — Environment Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Application URL ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://yeahtube.cekcok.my.id

# ── Authentication ──────────────────────────────────────
# Generate a random 256-bit base64-encoded secret:
#   openssl rand -base64 32
JWT_SECRET=generate-a-random-secret-here

# ── Initial Admin ───────────────────────────────────────
# Used by `npm run seed` to create the first admin user.
# Change this to a strong password immediately.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=set-a-strong-password

# ── Storage (MinIO S3-compatible) ───────────────────────
# Supported values: s3 (or leave unset for local filesystem)
STORAGE_TYPE=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=yeahtube
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ── Database (PostgreSQL) ───────────────────────────────
# Connection string format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/yeahtube

# ── Redis Cache & Queue ─────────────────────────────────
# Connection string format: redis://[:password@]host:port[/db]
REDIS_URL=redis://localhost:6379
